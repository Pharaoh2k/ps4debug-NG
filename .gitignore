# Build output
build/
*.o
*.a
*.elf
*.bin
*.obj

# Whitelist the vendored prebuilt static libs (needed to link the debugger
# without rebuilding their upstreams from source).
!debugger/third_party/keystone/lib/libkeystone.a
!debugger/third_party/cxxrt/lib/*.a

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*~

# Local dev tooling and Python cache (not part of the public release)
_tools/
__pycache__/
*.pyc

# Host unit-test binaries
tests/unit/test_debug_port
tests/unit/test_capability
tests/unit/test_attach_wait
tests/unit/test_attach_session
tests/unit/test_read_lz4
tests/unit/test_read_lz4_handle
